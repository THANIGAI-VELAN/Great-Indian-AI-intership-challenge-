# Dependencies
node_modules/
/.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# Next.js build output
.next/
out/
build/
dist/

# TypeScript build info
*.tsbuildinfo
next-env.d.ts

# Environment variables & secrets (CRITICAL: never commit keys)
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# Debug and runtime logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# Operating system files
.DS_Store
Thumbs.db
*.pem

# Python caches
__pycache__/
*.py[cod]
*$py.class

# IDE & Editor caches
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Vercel deployment cache
.vercel
.turbo

# Antigravity/Agent internal task logs & transcripts
**/.system_generated/
